#: model_terms:ir.ui.view,arch_db:l10n_pl_account_statement_import_online_enablebanking.l10n_pl_eb_connect_form
msgid ""
"<em>Privacy URL</em> and <em>Terms URL</em>\n"
"                                    are required in Production: links to the\n"
"                                    privacy policy and terms of your website.\n"
"                                    Also enter an e-mail for data protection\n"
"                                    matters."
msgstr ""
"<em>Privacy URL</em> i <em>Terms URL</em>\n"
"                                    są w Production obowiązkowe: linki do\n"
"                                    polityki prywatności i regulaminu na twojej\n"
"                                    stronie. Wpisz też e-mail do spraw ochrony\n"
"                                    danych."

#. module: l10n_pl_account_statement_import_online_enablebanking
#: model_terms:ir.ui.view,arch_db:l10n_pl_account_statement_import_online_enablebanking.l10n_pl_eb_connect_form
msgid ""
"<strong>Come back here</strong> and click\n"
"                            <em>I have the application</em>: upload the .pem file\n"
"                            and choose your bank."
msgstr ""
"<strong>Wróć tutaj</strong> i kliknij\n"
"                            <em>Mam aplikację</em>: wgraj plik .pem\n"
"                            i wybierz bank."

#. module: l10n_pl_account_statement_import_online_enablebanking
#: model_terms:ir.ui.view,arch_db:l10n_pl_account_statement_import_online_enablebanking.l10n_pl_eb_connect_form
msgid ""
"<strong>Create a free account.</strong>\n"
"                            Open"
msgstr ""
"<strong>Załóż darmowe konto.</strong>\n"
"                            Wejdź na"

#. module: l10n_pl_account_statement_import_online_enablebanking
#: model_terms:ir.ui.view,arch_db:l10n_pl_account_statement_import_online_enablebanking.l10n_pl_eb_connect_form
msgid ""
"<strong>Link your accounts.</strong>\n"
"                            On the list of applications click <em>Activate by\n"
"                            linking accounts</em> (Link accounts) next to the new\n"
"                            application. Choose Poland, the bank and\n"
"                            <em>Business</em> or <em>Personal</em>, log in to the\n"
"                            bank and tick the accounts. Repeat for every bank.\n"
"                            Without this the application sees no accounts. The\n"
"                            bank asks here for a consent of one day only: it just\n"
"                            puts the accounts on the allowed list. Odoo will ask\n"
"                            for its own consent of up to 180 days."
msgstr ""
"<strong>Podepnij swoje rachunki.</strong>\n"
"                            Na liście aplikacji kliknij przy nowej aplikacji\n"
"                            <em>Activate by linking accounts</em> (Link accounts).\n"
"                            Wybierz Polskę, bank oraz <em>Business</em> albo\n"
"                            <em>Personal</em>, zaloguj się w banku i zaznacz\n"
"                            rachunki. Powtórz to dla każdego banku. Bez tego\n"
"                            aplikacja nie widzi żadnego rachunku. Bank prosi tu\n"
"                            o zgodę tylko na jeden dzień, bo ten krok tylko wpisuje\n"
"                            rachunki na listę dozwolonych. Odoo poprosi potem\n"
"                            o własną zgodę, na maksymalnie 180 dni."

#. module: l10n_pl_account_statement_import_online_enablebanking
